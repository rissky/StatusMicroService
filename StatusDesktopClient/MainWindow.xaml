<Window x:Class="StatusDesktopClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StatusDesktopClient"
        mc:Ignorable="d"
        Title="Status Desktop Client" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Config Panel -->
            <RowDefinition Height="Auto"/>
            <!-- Error Message -->
            <RowDefinition Height="*"/>
            <!-- Main Content Grid -->
        </Grid.RowDefinitions>

        <!-- HEADER SECTION -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Netheret IT Status" FontSize="28" FontWeight="Bold" Foreground="#1D4ED8"/>
                <TextBlock Text="Live system monitoring dashboard" FontSize="14" Foreground="#6B7280" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Refresh Button (Ensure you have a Click event handler in your .cs file) -->
            <Button x:Name="RefreshButton" Grid.Column="1" Padding="15,10" 
                    Background="#2563EB" Foreground="White" FontWeight="SemiBold" 
                    BorderThickness="0" Cursor="Hand"
                    Content="Refresh Status" Click="RefreshButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- CONFIGURATION PANEL -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="API Endpoint URL:" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                <TextBox x:Name="ApiUrlInput" Text="http://localhost:5104/api/status" 
                         Padding="8" FontSize="14" BorderBrush="#D1D5DB" BorderThickness="1" Foreground="#1F2937">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <TextBlock Text="Update this to match the HTTP port shown in your C# API's terminal." 
                           FontSize="12" Foreground="#6B7280" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- ERROR MESSAGE (Hidden by default, toggle Visibility in C# if fetch fails) -->
        <Border x:Name="ErrorPanel" Grid.Row="2" Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="4,0,0,0" 
                Padding="15" Margin="0,0,0,20" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Connection Error" FontWeight="Bold" Foreground="#B91C1C"/>
                <TextBlock x:Name="ErrorText" Text="Unable to reach the API. Is the C# server running?" Foreground="#B91C1C" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- STATUS CARDS GRID -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="StatusListBox">
                <!-- Use a WrapPanel to make the cards flow like a grid (responsive) -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- How each individual status object should look -->
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" 
                                Width="240" Margin="0,0,20,20" Padding="20">
                            <!-- Drop Shadow for engaging 3D effect -->
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>

                            <StackPanel>
                                <TextBlock Text="{Binding ServiceName}" FontSize="18" FontWeight="Bold" Foreground="#1F2937" TextWrapping="Wrap"/>

                                <!-- Status Badge with Dynamic Styling -->
                                <Border CornerRadius="12" Padding="10,4" Margin="0,15,0,0" HorizontalAlignment="Left">
                                    <!-- Use Style Triggers directly on the Border instead -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                            <!-- Default (Online) -->
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Degraded">
                                                    <Setter Property="Background" Value="#FEF9C3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <!-- Use Style Triggers directly on the TextBlock -->
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#166534"/>
                                                <!-- Default (Online) -->
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Degraded">
                                                        <Setter Property="Foreground" Value="#854D0E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <TextBlock Text="{Binding Id, StringFormat='System ID: {0}'}" FontSize="12" Foreground="#9CA3AF" Margin="0,15,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</Window>